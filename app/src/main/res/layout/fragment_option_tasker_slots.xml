<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cockpit_screen_bg">

    <include layout="@layout/partial_detail_header" />

    <TextView
        style="@style/Br80.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ogni Tasto Virtuale identifica un'automazione Tasker: mappalo su un tasto/gesto qui nell'app e scegli lo stesso nome nella configurazione dell'Evento dentro Tasker. Rinominarlo aggiorna anche il testo pronunciato via TTS."
        android:padding="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/llTaskerSlotsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp" />

    </ScrollView>

    <Button
        android:id="@+id/btnAddTaskerSlot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="+ Aggiungi Tasto Virtuale"
        android:textSize="13sp"
        android:backgroundTint="@color/cockpit_card"
        android:textColor="@color/cockpit_ink" />

</LinearLayout>
