<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cockpit_screen_bg">

    <!-- Top App Header & Quick Connection Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/cockpit_card"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:elevation="2dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVALL BR80"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:textColor="@color/cockpit_ink" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@color/status_error"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvHeaderStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disconnesso"
                    android:textSize="13sp"
                    android:textColor="@color/cockpit_muted" />

                <TextView
                    android:id="@+id/tvHeaderBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="@color/cockpit_ink"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnQuickConnect"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Connetti"
            android:textSize="13sp"
            android:paddingHorizontal="14dp"
            android:backgroundTint="@color/cockpit_accent"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!-- Main Content Area (3 Tabs) -->
    <!-- Contenitore dei 3 Fragment (Controller/Opzioni/Log), gestiti in MainActivity -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />


    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/cockpit_card"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/navBtnController"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎮"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvNavTextController"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Controller"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/cockpit_accent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navBtnOptions"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvNavTextOptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Opzioni"
                android:textSize="11sp"
                android:textColor="@color/cockpit_muted" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navBtnLog"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📜"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvNavTextLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log"
                android:textSize="11sp"
                android:textColor="@color/cockpit_muted" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
