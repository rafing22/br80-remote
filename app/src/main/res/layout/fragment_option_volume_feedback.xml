<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cockpit_screen_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/partial_detail_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Feedback alla Pressione (Guanti)"
                style="@style/Br80.Text.RowTitle"
                android:layout_marginBottom="10dp" />

            <CheckBox
                android:id="@+id/cbOptHaptic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vibrazione breve di conferma"
                android:textSize="14sp"
                android:textColor="@color/cockpit_ink" />

            <TextView
                style="@style/Br80.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Un breve impulso ad ogni azione eseguita: percepibile anche con i guanti, senza dover guardare il telefono."
                android:layout_marginStart="32dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <CheckBox
                android:id="@+id/cbOptSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Beep audio di conferma"
                android:textSize="14sp"
                android:textColor="@color/cockpit_ink" />

            <TextView
                style="@style/Br80.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Un breve tono ad ogni azione eseguita, udibile dallo speaker del telefono."
                android:layout_marginStart="32dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <CheckBox
                android:id="@+id/cbOptTts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Annuncio vocale (TTS) delle azioni"
                android:textSize="14sp"
                android:textColor="@color/cockpit_ink" />

            <TextView
                style="@style/Br80.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pronuncia ad alta voce ogni azione eseguita, utile con interfono/casco."
                android:layout_marginStart="32dp"
                android:layout_marginTop="4dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
