<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cockpit_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/cockpit_card"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Log Eventi Real-Time"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/cockpit_ink" />

        <TextView
            android:id="@+id/btnLogCopy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Copia"
            android:textSize="13sp"
            android:textColor="@color/cockpit_accent"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnLogExport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Esporta"
            android:textSize="13sp"
            android:textColor="#4ADE80"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnLogClearTab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pulisci"
            android:textSize="13sp"
            android:textColor="@color/cockpit_accent_bright"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/svLogFull"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvLogFull"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/cockpit_muted"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="[READY] Registro eventi inizializzato..." />
    </ScrollView>

</LinearLayout>
