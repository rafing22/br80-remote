<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cockpit_card" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/cockpit_border" />
        </shape>
    </item>
    <item android:left="0dp" android:width="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/cockpit_accent" />
            <corners
                android:topLeftRadius="14dp"
                android:bottomLeftRadius="14dp" />
        </shape>
    </item>
</layer-list>
